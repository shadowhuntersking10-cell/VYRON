# ==============================================================================
# VYRON — Gaming & Digital Marketplace
# PLAY. BUY. DONATE.
#
# Copy to .env and fill in. NEVER commit real credentials.
# Every integration degrades safely: if credentials are missing the feature
# reports a structured *_NOT_CONFIGURED error instead of faking success.
# ==============================================================================

# --- Core ---------------------------------------------------------------------
VYRON_ENV=development                  # development | staging | production
VYRON_HOST=0.0.0.0
VYRON_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000  # public origin used in links/Telegram Web App
SESSION_SECRET=                        # REQUIRED: 32+ random bytes hex. openssl rand -hex 32
ALLOWED_ORIGINS=                       # comma-separated extra CORS origins (public base is always allowed)

# --- MySQL (main database — required) ------------------------------------------
DATABASE_URL=mysql+pymysql://vyron:vyron_dev_password@127.0.0.1:3306/vyron?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=0

# --- Redis (queues, rate limiting, caching — required) --------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Alembic migrations ----------------------------------------------------------
AUTO_MIGRATE_ON_START=1                # run `alembic upgrade head` inside main.py

# --- SMTP (email notifications; without it emails are queued & reported skipped) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
SMTP_FROM=no-reply@vyron.app

# --- Telegram ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                    # from @BotFather. Bot disabled (with warning) if empty
TELEGRAM_MINIAPP_URL=                  # defaults to PUBLIC_BASE_URL + /miniapp
ADMIN_TELEGRAM_IDS=                    # e.g. 123456789,987654321 — server-side admin gate

# --- Payments -----------------------------------------------------------------------
PAYMENT_PROVIDER=                      # payme | click | stripe  (default active provider)
PAYME_MERCHANT_ID=
PAYME_SECRET=                          # merchant secret key (server-side)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYMENT_SUCCESS_REDIRECT=              # defaults to /dashboard/orders
PAYMENT_CANCEL_REDIRECT=               # defaults to /checkout/cancelled

# --- Suppliers (digital goods delivery) ----------------------------------------------
SUPPLIER_API_KEY=
SUPPLIER_API_SECRET=
SUPPLIER_API_BASE_URL=                 # base URL of the configured HTTP supplier
SUPPLIER_TIMEOUT_SECONDS=30
SUPPLIER_MAX_ATTEMPTS=3

# --- S3-compatible object storage (listing/game images) --------------------------------
S3_ENDPOINT=                           # e.g. https://s3.example.com or minio:9000
S3_BUCKET=vyron
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_SECURE=1
S3_PUBLIC_URL=                         # optional CDN prefix
UPLOAD_MAX_BYTES=5242880
LOCAL_UPLOAD_DIR=static/uploads        # fallback when S3 is not configured

# --- Revenue & fees (all configurable at runtime via Admin → Settings; these are defaults)
MARKETPLACE_COMMISSION_PCT=10.0        # % taken from each seller sale
DONATION_FEE_PCT=5.0                   # transparent platform fee on donations
DONATION_FEE_FIXED=0.00
SERVICE_FEE_PCT=0.0                    # optional service fee shown at checkout
SELLER_HOLDING_PERIOD_HOURS=72         # pending → available after this many hours
MIN_PAYOUT_AMOUNT=10.00
PROMOTED_LISTING_PRICE=5.00
FEATURED_LISTING_PRICE=10.00

# --- Bootstrap --------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com     # first SUPER_ADMIN — seeded automatically by python main.py
ADMIN_PASSWORD=                        # min 10 chars; REQUIRED for seeding
ADMIN_USERNAME=vyron_admin
SEED_DEMO_DATA=1                       # seed clearly-labelled DEV games/products (never fake money)

# --- Security tuning ---------------------------------------------------------------------
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_RESET=5/hour
RATE_LIMIT_WEBHOOK=600/minute
CSRF_ENABLED=1
TRUST_PROXY_HEADERS=0
SESSION_TTL_DAYS=30
BCRYPT_FALLBACK=0                      # argon2id is default

# --- Observability ------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=1
