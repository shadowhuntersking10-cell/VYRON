# ============ VYRON environment ============
# Copy to .env and fill in real values. NEVER commit .env.
APP_ENV=development
APP_NAME=VYRON
APP_SECRET=change-me-to-a-long-random-secret
BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# ---- MySQL (production) ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
DATABASE_URL=
# Example: DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/vyron?charset=utf8mb4
# Dev fallback: if empty and APP_ENV != production, a local dev.db (SQLite) is used
# with a loud warning. Production REQUIRES MySQL.

# ---- Redis (optional, in-memory fallback when empty) ----
REDIS_URL=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
ADMIN_TELEGRAM_IDS=

# ---- Business safety switches ----
SALES_ENABLED=true
SUPPLIER_ORDERS_ENABLED=true
PAYMENTS_ENABLED=true
LOSS_SELLING=false

# ---- Pricing / fees (defaults, overridable in admin Settings) ----
PAYMENT_FEE_PERCENT=2.0
PAYMENT_FEE_FIXED=500
SAFETY_BUFFER_PERCENT=2.0
PLATFORM_MARGIN_PERCENT=10.0
PLATFORM_FEE_PERCENT=5.0
MINIMUM_MARGIN_PERCENT=5.0
MAXIMUM_DISCOUNT_PERCENT=30.0
MARKETPLACE_COMMISSION_PERCENT=10.0
DONATION_FEE_PERCENT=5.0
DEFAULT_CURRENCY=UZS

# ---- Payments ----
PAYME_MERCHANT_ID=
PAYME_SECRET=
PAYME_ENDPOINT=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
CLICK_ENDPOINT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Supplier ----
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
SUPPLIER_AUTO_PRICE_UPDATE=false

# ---- Media / storage (local storage used when empty) ----
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
MEDIA_DIR=static/uploads
MAX_UPLOAD_MB=5

# ---- SMTP (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vyron.example.com
