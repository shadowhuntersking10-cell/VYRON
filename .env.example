# ============================================================
# VYRON — environment configuration (placeholders ONLY)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Core ----
APP_ENV=production
APP_DEBUG=false
PUBLIC_BASE_URL=https://your-domain.example
WEBAPP_URL=https://your-domain.example
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=mysql+pymysql://vyron:vyron_password@127.0.0.1:3306/vyron
DATABASE_FALLBACK_SQLITE=true

# ---- Payerpin (supplier / fulfillment) ----
PAYERPIN_API_KEY=
PAYERPIN_BASE_URL=https://api.payerpin.uz

# ---- Payments (payment provider is SEPARATE from Payerpin) ----
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=UZS

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# ---- Optional ----
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
FULFILLMENT_WORKER_ENABLED=true
FULFILLMENT_POLL_SECONDS=5
CATALOG_SYNC_INTERVAL_MINUTES=60
RATE_LIMIT_ENABLED=true
