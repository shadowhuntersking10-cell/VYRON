# ============================================================
# VYRON - Environment configuration example
# Copy to .env and fill real values. NEVER commit .env
#   cp .env.example .env
# ============================================================

# ---- App ----
APP_ENV=development
APP_NAME=VYRON
APP_SECRET=change-me-to-a-long-random-secret-min-32-chars
APP_BASE_URL=http://localhost:8000
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_LANG=uz
DEFAULT_CURRENCY=UZS

# ---- MySQL (primary production database) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=vyron
MYSQL_USER=vyron
MYSQL_PASSWORD=change-me

# Full override (optional). If set, it wins over MYSQL_* parts.
# MySQL example:  mysql+asyncmy://vyron:pass@localhost:3306/vyron
# Dev fallback:   sqlite+aiosqlite:///./vyron_dev.db
DATABASE_URL=

# ---- Redis (optional but recommended) ----
# e.g. redis://localhost:6379/0
REDIS_URL=

# ---- Sessions / security ----
SESSION_COOKIE_NAME=vyron_session
SESSION_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=https://yourdomain.com/miniapp
# Comma-separated Telegram user IDs that get ADMIN privileges
ADMIN_TELEGRAM_IDS=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# ---- Payments: Payme ----
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# ---- Payments: Click ----
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_TEST_MODE=true

# ---- Payments: Stripe ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true

# ---- Suppliers ----
# Default supplier selection per game is done in Admin Panel.
# Credentials below enable real top-up providers.
SUPPLIER_DEFAULT=manual
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
SUPPLIER_API_SECRET=
SUPPLIER_MERCHANT_ID=

# ---- SMTP (verification / password reset emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---- Storage (local by default; S3-compatible optional) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_MB=5
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ---- Marketplace / revenue defaults ----
MARKETPLACE_COMMISSION_PERCENT=10.0
DONATION_FEE_PERCENT=5.0
SERVICE_FEE_FIXED=0
SERVICE_FEE_PERCENT=0.0

# ---- Seed ----
# Create initial admin user + demo catalog on first boot (dev only)
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@vyron.local
ADMIN_PASSWORD=Admin12345!
